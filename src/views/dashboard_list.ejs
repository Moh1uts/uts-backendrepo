<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title><%= title %> — United Transport Solutions</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="topnav">
  <div class="wrap">
    <span class="brand">United Transport Solutions — Backend</span>
    <a href="/potential">Potential Clients</a>
    <a href="/active">Active Clients</a>
    <a href="/refused">Refused Clients</a>
    <a href="/invoices">Invoices</a>
    <a href="/report">Monthly Report</a>
    <a href="/clients/new">+ Add Client</a>
    <form method="POST" action="/logout"><button class="logout">Logout</button></form>
  </div>
</nav>
<main class="wrap">
  <h1><%= title %> <span class="badge <%= category %>"><%= clients.length %></span></h1>

  <% if (clients.length === 0) { %>
    <div class="card">No clients in this category yet.</div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Phone</th>
          <th>Email</th>
          <th>Route</th>
          <th>Nature</th>
          <th>Source</th>
          <th>Received</th>
        </tr>
      </thead>
      <tbody>
        <% clients.forEach(c => { %>
          <tr>
            <td><a class="row-link" href="/clients/<%= c.id %>"><%= c.name %></a></td>
            <td><%= c.phone %></td>
            <td><%= c.email %></td>
            <td><%= c.city %> → <%= c.destination %></td>
            <td><%= c.nature %></td>
            <td><%= c.source %></td>
            <td><%= new Date(c.createdAt).toLocaleDateString('fr-FR') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</main>
</body>
</html>
