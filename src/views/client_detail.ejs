<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title><%= client.name %> — United Transport Solutions</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="topnav">
  <div class="wrap">
    <span class="brand">United Transport Solutions — Backend</span>
    <a href="/potential">Potential Clients</a>
    <a href="/active">Active Clients</a>
    <a href="/refused">Refused Clients</a>
    <a href="/invoices">Invoices</a>
    <a href="/report">Monthly Report</a>
    <a href="/clients/new">+ Add Client</a>
    <form method="POST" action="/logout"><button class="logout">Logout</button></form>
  </div>
</nav>
<main class="wrap">
  <% if (flash) { %><div class="flash"><%= flash %></div><% } %>

  <h1><%= client.name %> <span class="badge <%= client.status %>"><%= client.status %></span></h1>

  <div class="card">
    <div class="field-grid">
      <div><label>Phone</label><%= client.phone %></div>
      <div><label>Email</label><%= client.email %></div>
      <div><label>Route</label><%= client.city %> → <%= client.destination %></div>
      <div><label>Nature of goods</label><%= client.nature %></div>
      <div><label>Packages</label><%= client.packages ?? '—' %></div>
      <div><label>Gross weight</label><%= client.weightKg ? client.weightKg + ' kg' : '—' %></div>
      <div><label>Volume</label><%= client.volume || '—' %></div>
      <div><label>ICE</label><%= client.ice || '—' %></div>
      <div><label>Preferred date</label><%= client.preferredDate || '—' %></div>
      <div><label>Source</label><%= client.source %></div>
      <div class="full"><label>Notes</label><%= client.notes || '—' %></div>
      <% if (client.refusalReason) { %>
        <div class="full"><label>Refusal reason</label><%= client.refusalReason %></div>
      <% } %>
    </div>
  </div>

  <% if (client.status === 'potential') { %>
    <h2>Actions</h2>
    <div class="action-grid">
      <div class="action-box">
        <h3>✅ Ready to work with you</h3>
        <p style="font-size:12.5px; color:var(--navy-soft);">Tells the client we can take the order and to call us.</p>
        <form method="POST" action="/clients/<%= client.id %>/ready-to-work">
          <button class="btn green small" type="submit">Send</button>
        </form>
      </div>

      <div class="action-box">
        <h3>❌ Sorry, we can't</h3>
        <form method="POST" action="/clients/<%= client.id %>/refuse">
          <textarea name="reason" placeholder="Reason (required)" required></textarea>
          <button class="btn red small" type="submit">Send &amp; move to Refused</button>
        </form>
      </div>

      <div class="action-box">
        <h3>🔔 Rewake (no response yet)</h3>
        <p style="font-size:12.5px; color:var(--navy-soft);">Friendly reminder that we're still available.</p>
        <form method="POST" action="/clients/<%= client.id %>/rewake">
          <button class="btn ghost small" type="submit">Send reminder</button>
        </form>
      </div>

      <div class="action-box">
        <h3>➡️ Move to Active Clients</h3>
        <p style="font-size:12.5px; color:var(--navy-soft);">Once the client has confirmed acceptance.</p>
        <form method="POST" action="/clients/<%= client.id %>/activate">
          <button class="btn small" type="submit">Move to Active</button>
        </form>
      </div>
    </div>
  <% } %>

  <% if (client.status === 'active') { %>
    <h2>Order actions</h2>
    <div class="action-grid">
      <div class="action-box">
        <h3>1. Order received (phone/message)</h3>
        <form method="POST" action="/clients/<%= client.id %>/order-received">
          <button class="btn small" type="submit">Log &amp; notify client</button>
        </form>
      </div>

      <div class="action-box">
        <h3>2. Order shipped</h3>
        <form method="POST" action="/clients/<%= client.id %>/order-shipped">
          <input name="trackingNumber" placeholder="Tracking number" required>
          <button class="btn small" type="submit">Send</button>
        </form>
      </div>

      <div class="action-box">
        <h3>3. Order arrived (generates invoice)</h3>
        <form method="POST" action="/clients/<%= client.id %>/order-arrived">
          <input name="flightNumber" placeholder="Flight number (e.g. AF 1597)">
          <input name="lta" placeholder="LTA number">
          <input type="number" step="0.01" name="amountHT" placeholder="Amount H.T. (MAD)" required>
          <button class="btn green small" type="submit">Generate invoice &amp; send</button>
        </form>
      </div>

      <div class="action-box">
        <h3>4. Order late</h3>
        <form method="POST" action="/clients/<%= client.id %>/order-late">
          <textarea name="reason" placeholder="Reason (required)" required></textarea>
          <button class="btn small" type="submit">Send</button>
        </form>
      </div>

      <div class="action-box">
        <h3>5. Problem with order</h3>
        <form method="POST" action="/clients/<%= client.id %>/order-problem">
          <textarea name="reason" placeholder="Reason (required)" required></textarea>
          <button class="btn small" type="submit">Send</button>
        </form>
      </div>

      <div class="action-box">
        <h3>6. Order cancelled</h3>
        <form method="POST" action="/clients/<%= client.id %>/order-cancelled">
          <textarea name="reason" placeholder="Reason (required)" required></textarea>
          <button class="btn red small" type="submit">Send</button>
        </form>
      </div>
    </div>
  <% } %>

  <% if (client.status === 'refused') { %>
    <h2>Actions</h2>
    <div class="action-grid">
      <div class="action-box">
        <h3>1. Invite back — circumstances changed</h3>
        <p style="font-size:12.5px; color:var(--navy-soft);">We can now handle the same order.</p>
        <form method="POST" action="/clients/<%= client.id %>/invite-back-same">
          <button class="btn green small" type="submit">Send</button>
        </form>
      </div>

      <div class="action-box">
        <h3>2. Invite back — different service</h3>
        <form method="POST" action="/clients/<%= client.id %>/invite-back-other">
          <input name="serviceOffer" placeholder="Describe the other service" required>
          <button class="btn small" type="submit">Send</button>
        </form>
      </div>
    </div>
  <% } %>

  <% if (invoices.length > 0) { %>
    <h2>Invoices for this client</h2>
    <table>
      <thead><tr><th>Invoice N°</th><th>Date</th><th>Amount TTC</th><th></th></tr></thead>
      <tbody>
        <% invoices.forEach(inv => { %>
          <tr>
            <td><%= inv.invoiceNumber %></td>
            <td><%= new Date(inv.createdAt).toLocaleDateString('fr-FR') %></td>
            <td><%= inv.amountTTC.toFixed(2) %> MAD</td>
            <td><a href="/invoices/<%= inv.id %>/download">Download PDF</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <h2>History</h2>
  <div class="card">
    <% if (events.length === 0) { %>
      <p>No events yet.</p>
    <% } %>
    <% events.forEach(e => { %>
      <div class="history-item">
        <span class="date"><%= new Date(e.createdAt).toLocaleString('fr-FR') %></span>
        <span class="type"><%= e.type %></span>
        <% if (e.reason) { %> — <%= e.reason %><% } %>
        <% if (e.trackingNumber) { %> — tracking: <%= e.trackingNumber %><% } %>
        <% if (e.serviceOffer) { %> — <%= e.serviceOffer %><% } %>
        <% if (e.messageSent === false) { %> <span style="color:var(--red);">(message failed — check SMS/email config)</span><% } %>
      </div>
    <% }) %>
  </div>
</main>
</body>
</html>
